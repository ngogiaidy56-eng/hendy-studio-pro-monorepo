{
  "name": "@hendy/core-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "worker": "tsx src/workers/render.worker.ts",
    "test": "tsx --test src/tests/*.test.ts",
    "check:env": "node ../../scripts/validate-env.mjs",
    "cleanup:stale-assets": "tsx src/scripts/cleanup-stale-assets.ts",
    "cleanup:stale-renders": "tsx src/scripts/cleanup-stale-renders.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "pg": "^8.13.1",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1",
    "express-rate-limit": "^7.5.0",
    "@hendy/core-utils": "workspace:*",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

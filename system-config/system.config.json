{
  "$schema": "./schema/system-config.schema.json",
  "schemaVersion": 1,
  "app": {
    "name": "Hendy Studio Pro",
    "slug": "hendy-studio-pro",
    "version": "1.2.0",
    "defaultLocale": "vi-VN"
  },
  "network": {
    "apiPort": 8080,
    "adminPort": 5173,
    "studioPort": 5174,
    "ktorPort": 8090,
    "maxTrustedProxyHops": 0,
    "releaseCenterPort": 5175,
    "marketingPort": 5176
  },
  "media": {
    "maxUploadBytes": 2147483648,
    "maxSubtitleBytes": 10485760,
    "maxImageBytes": 104857600,
    "maxSourceBytesPerRender": 4294967296,
    "maxOutputBytes": 2147483648,
    "maxClipsPerRender": 1000,
    "maxUniqueAssetsPerRender": 128,
    "maxTimelineSeconds": 43200,
    "supportedVideoMimeTypes": [
      "video/mp4",
      "video/quicktime"
    ],
    "supportedAudioMimeTypes": [
      "audio/mpeg",
      "audio/wav"
    ],
    "supportedImageMimeTypes": [
      "image/png",
      "image/jpeg"
    ],
    "subtitleRenderFormat": "srt"
  },
  "security": {
    "jwtAccessTtl": "15m",
    "presignedUrlTtlSeconds": 300,
    "productionJwtSecretMinBytes": 32,
    "productionAdminPasswordMinChars": 16,
    "metricsTokenMinChars": 24
  },
  "features": {
    "rbac": true,
    "auditLog": true,
    "localWhisperAgent": true,
    "geminiTranslation": true,
    "cloudRender": true,
    "telegramMiniApp": false,
    "billingWebhooks": false,
    "animatedKeyframes": false,
    "advancedTransitions": false,
    "assSubtitleStyling": false,
    "nativeReleasePipeline": true,
    "appPublishingCenter": true
  }
}
